@{
    ViewData["Title"] = "Моніторинг доставок в реальному часі";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-map-location-dot"></i> Карта розташування посилок та кур'єрів
                </h5>
            </div>
            <div class="card-body p-0">
                <div id="map" style="height: 600px; border-radius: 0 0 .25rem .25rem;"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-filter"></i> Фільтри
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Регіон:</label>
                    <select class="form-select" id="regionFilter">
                        <option value="">Усі регіони</option>
                        <option value="1">Регіон 1 (Київ, Харків)</option>
                        <option value="2">Регіон 2 (Львів, Одеса)</option>
                        <option value="3">Регіон 3 (Інші міста)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Статус:</label>
                    <div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="statusStored" checked>
                            <label class="form-check-label" for="statusStored">
                                📦 На складі
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="statusInTransit" checked>
                            <label class="form-check-label" for="statusInTransit">
                                🚚 У дорозі
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="statusDelivered" checked>
                            <label class="form-check-label" for="statusDelivered">
                                ✅ Доставлено
                            </label>
                        </div>
                    </div>
                </div>

                <button class="btn btn-success w-100 mb-3" id="refreshBtn">
                    <i class="fas fa-sync"></i> Оновити дані
                </button>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar"></i> Статистика
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted">Усього посилок</small>
                    <h6 id="totalShipments">0</h6>
                </div>
                <div class="mb-2">
                    <small class="text-muted">У дорозі</small>
                    <h6 id="inTransitCount">0</h6>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Доставлено</small>
                    <h6 id="deliveredCount">0</h6>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tracking.js"></script>
}
