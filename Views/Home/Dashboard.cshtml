@{
    ViewData["Title"] = "Панель керування - Smart-Post";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">
    <i class="fas fa-chart-line"></i> Панель керування Smart-Post
</h2>

<div class="row mb-4">
    <!-- Карточка: Усього посилок -->
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-box"></i> Усього посилок
                </h5>
                <h2 id="totalShipmentsCount">0</h2>
                <small>Загальна кількість в системі</small>
            </div>
        </div>
    </div>

    <!-- Карточка: У дорозі -->
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-truck"></i> У дорозі
                </h5>
                <h2 id="inTransitCount">0</h2>
                <small>Активні доставки</small>
            </div>
        </div>
    </div>

    <!-- Карточка: Доставлено -->
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-check-circle"></i> Доставлено
                </h5>
                <h2 id="deliveredCount">0</h2>
                <small>Успішно доставлено</small>
            </div>
        </div>
    </div>

    <!-- Карточка: Кур'єрів активних -->
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-person"></i> Активних кур'єрів
                </h5>
                <h2 id="activeCouriersCount">0</h2>
                <small>Онлайн кур'єрів</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Статистика по регіонам -->
    <div class="col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    <i class="fas fa-map"></i> Розподіл по регіонах
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Регіон</th>
                                <th>На складі</th>
                                <th>У дорозі</th>
                                <th>Доставлено</th>
                                <th>Усього</th>
                            </tr>
                        </thead>
                        <tbody id="regionStatsTable">
                            <tr>
                                <td colspan="5" class="text-center text-muted">Завантаження...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Статус шардів -->
    <div class="col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    <i class="fas fa-database"></i> Статус шардів (БД вузлів)
                </h5>
            </div>
            <div class="card-body">
                <div id="shardStatus">
                    <div class="text-center text-muted py-4">
                        <div class="spinner-border mb-2" role="status">
                            <span class="visually-hidden">Завантаження...</span>
                        </div>
                        <p>Перевірка статусу шардів...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Таблиця останніх посилок -->
<div class="card shadow mt-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">
            <i class="fas fa-list"></i> Останні посилки
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="shipmentsTable">
                <thead>
                    <tr>
                        <th>Номер трекування</th>
                        <th>ID</th>
                        <th>Регіон</th>
                        <th>Статус</th>
                        <th>Дата реєстрації</th>
                        <th>Дія</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6" class="text-center text-muted">Завантаження...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .table-responsive {
        border-radius: 8px;
        overflow: hidden;
    }

    .badge-pill {
        padding: 6px 12px;
        font-weight: 500;
    }
</style>

@section Scripts {
    <script>
        // Ініціалізація панелі
        document.addEventListener('DOMContentLoaded', function() {
            loadDashboardData();
            loadRegionStats();
            loadShardStatus();
            loadRecentShipments();

            // Оновлення кожні 10 секунд
            setInterval(loadDashboardData, 10000);
            setInterval(loadRegionStats, 15000);
            setInterval(loadShardStatus, 20000);
        });

        async function loadDashboardData() {
            try {
                // Для демо генеруємо дані
                const data = generateDashboardData();
                
                document.getElementById('totalShipmentsCount').textContent = data.total;
                document.getElementById('inTransitCount').textContent = data.inTransit;
                document.getElementById('deliveredCount').textContent = data.delivered;
                document.getElementById('activeCouriersCount').textContent = data.activeCouriers;
            } catch (error) {
                console.error('Помилка завантаження даних:', error);
            }
        }

        function generateDashboardData() {
            return {
                total: Math.floor(Math.random() * 1000) + 100,
                inTransit: Math.floor(Math.random() * 100) + 20,
                delivered: Math.floor(Math.random() * 500) + 50,
                activeCouriers: Math.floor(Math.random() * 80) + 10
            };
        }

        async function loadRegionStats() {
            try {
                const regions = [
                    { name: 'Київ, Харків', stored: 45, inTransit: 32, delivered: 128 },
                    { name: 'Львів, Одеса', stored: 28, inTransit: 18, delivered: 92 },
                    { name: 'Інші міста', stored: 67, inTransit: 54, delivered: 213 }
                ];

                const tbody = document.querySelector('#regionStatsTable tbody');
                tbody.innerHTML = regions.map(r => `
                    <tr>
                        <td><strong>${r.name}</strong></td>
                        <td><span class="badge bg-warning">${r.stored}</span></td>
                        <td><span class="badge bg-info">${r.inTransit}</span></td>
                        <td><span class="badge bg-success">${r.delivered}</span></td>
                        <td><strong>${r.stored + r.inTransit + r.delivered}</strong></td>
                    </tr>
                `).join('');
            } catch (error) {
                console.error('Помилка завантаження статистики регіонів:', error);
            }
        }

        async function loadShardStatus() {
            try {
                const response = await fetch('/api/gateway/sharding-info');
                const data = await response.json();

                const shardStatusDiv = document.getElementById('shardStatus');
                shardStatusDiv.innerHTML = `
                    <div class="alert alert-info mb-0">
                        <h6 class="mb-2">Стратегія шардингу: <strong>${data.strategy}</strong></h6>
                        <p class="mb-0 small">${data.description}</p>
                    </div>
                    <div class="mt-3">
                        <h6>Статус вузлів:</h6>
                        <div class="d-flex gap-2">
                            ${[1, 2, 3].map(i => `
                                <div class="flex-shrink-0">
                                    <div class="badge bg-success p-2">
                                        <i class="fas fa-server"></i> Шард #${i}<br>
                                        <small>✅ Активний</small>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } catch (error) {
                console.error('Помилка завантаження статусу шардів:', error);
                document.getElementById('shardStatus').innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="fas fa-exclamation-circle"></i> Помилка завантаження даних
                    </div>
                `;
            }
        }

        async function loadRecentShipments() {
            try {
                // Для демо генеруємо дані
                const shipments = Array.from({ length: 8 }, (_, i) => ({
                    track: 'TRK' + (i + 1),
                    id: 'UA-' + Math.random().toString(36).substr(2, 8),
                    region: (i % 3) + 1,
                    status: ['Stored', 'InTransit', 'Delivered'][i % 3],
                    date: new Date(Date.now() - Math.random() * 86400000).toLocaleString('uk-UA')
                }));

                const tbody = document.querySelector('#shipmentsTable tbody');
                tbody.innerHTML = shipments.map(s => `
                    <tr>
                        <td><strong>${s.track}</strong></td>
                        <td><code>${s.id.substring(0, 12)}...</code></td>
                        <td>Регіон ${s.region}</td>
                        <td>
                            <span class="badge ${
                                s.status === 'Stored' ? 'bg-warning' :
                                s.status === 'InTransit' ? 'bg-info' :
                                'bg-success'
                            }">
                                ${s.status === 'Stored' ? '📦' : s.status === 'InTransit' ? '🚚' : '✅'} 
                                ${s.status}
                            </span>
                        </td>
                        <td><small>${s.date}</small></td>
                        <td>
                            <a href="/home/trackshipment?track=${s.track}" class="btn btn-sm btn-primary">
                                <i class="fas fa-eye"></i> Переглянути
                            </a>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                console.error('Помилка завантаження посилок:', error);
            }
        }
    </script>
}
